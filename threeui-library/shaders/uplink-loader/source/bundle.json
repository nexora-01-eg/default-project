      "code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>SYS.LINK — Uplink Sequence</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Geist+Mono:wght@200..700&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    /* design canvas: 1200 x 800 units, scaled to fit the viewport */\n    --s: 1;\n\n    --bg:        #030806;\n    --green:     #2fe07d;\n    --green-dim: rgba(55,225,130,.26);\n    --line:      rgba(120,255,185,.46);\n    --ink-hi:    #d9f4e6;\n  }\n\n  *{box-sizing:border-box;margin:0;padding:0}\n  html,body{height:100%}\n  body{\n    background:var(--bg);\n    overflow:hidden;\n    font-family:\"Geist Mono\",ui-monospace,SFMono-Regular,Menlo,monospace;\n    -webkit-font-smoothing:antialiased;\n  }\n\n  /* a cold pool of light behind the rig */\n  .pool{\n    position:fixed; inset:0; pointer-events:none;\n    background:radial-gradient(ellipse 60% 44% at 50% 52%,\n      rgba(24,150,92,.17) 0%, rgba(16,104,66,.08) 38%, rgba(10,58,38,.025) 66%, transparent 100%);\n  }\n\n  /* ── stage ── */\n  .scene{position:fixed; inset:0; overflow:hidden}\n  .stage{\n    position:absolute; left:50%; top:50%; width:1200px; height:800px;\n    transform:translate(-50%,-50%) scale(var(--s)); transform-origin:center;\n  }\n  .stage > *{position:absolute}\n\n  /* ── readout plate ── */\n  .plate{\n    left:530px; top:270px; width:140px; height:84px;\n    background:var(--line);\n    clip-path:polygon(14px 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%, 0 14px);\n  }\n  .plate::after{\n    content:\"\"; position:absolute; inset:1.2px;\n    background:linear-gradient(180deg,#07251a,#041a12);\n    clip-path:polygon(13px 0, 100% 0, 100% calc(100% - 13px), calc(100% - 13px) 100%, 0 100%, 0 13px);\n  }\n  .plate.hit{animation:plateHit .5s ease-out}\n  @keyframes plateHit{0%{background:#c8ffe2}100%{background:var(--line)}}\n\n  .brk{width:9px;height:9px;pointer-events:none}\n  .brk::before,.brk::after{content:\"\"; position:absolute; background:var(--green); opacity:.9}\n  .brk::before{width:9px;height:1.2px} .brk::after{width:1.2px;height:9px}\n  .brk.tr{left:661px; top:270px} .brk.tr::before{right:0;top:0} .brk.tr::after{right:0;top:0}\n  .brk.bl{left:530px; top:345px} .brk.bl::before{left:0;bottom:0} .brk.bl::after{left:0;bottom:0}\n\n  .readout{\n    left:530px; top:284.9px; width:140px; height:0;\n    text-align:center; line-height:1; white-space:pre;\n    color:var(--green);\n    text-shadow:0 0 4px rgba(70,235,145,.6), 0 0 14px rgba(48,210,125,.55), 0 0 36px rgba(32,175,105,.4);\n    animation:neon 4.3s steps(1,end) infinite;\n  }\n  .readout b{font-size:47px; font-weight:280; letter-spacing:2.4px}\n  .readout u{font-size:15px; font-weight:400; letter-spacing:0; text-decoration:none;\n             opacity:.62; position:relative; top:-1px; left:3px}\n  @keyframes neon{\n    0%,40%{opacity:1} 41%{opacity:.55} 42%{opacity:1}\n    67%{opacity:1} 68%{opacity:.72} 69.5%{opacity:1} 70.5%{opacity:.42} 71.5%{opacity:1}\n  }\n\n  /* ── progress bar ── */\n  .haze{left:298px; top:438px; width:0; height:0; pointer-events:none}\n  .haze i{\n    position:absolute; left:0; top:0;\n    width:calc(var(--lit-w,0px) + 250px); height:250px;\n    transform:translate(-125px,-128px);\n    background:radial-gradient(ellipse 50% 50% at center,\n      rgba(56,225,140,.26) 0%, rgba(46,200,126,.17) 22%,\n      rgba(38,170,108,.082) 45%, rgba(30,140,90,.024) 70%, transparent 100%);\n    filter:blur(6px);\n    transition:width .16s linear;\n  }\n  .haze i.pulse{animation:hazePulse .3s ease-out}\n  @keyframes hazePulse{0%{filter:blur(6px) brightness(1.3)}100%{filter:blur(6px) brightness(1)}}\n\n  .bar{left:298px; top:420px; width:604px; height:44px;\n       display:flex; justify-content:space-between; align-items:flex-end}\n  .tick{width:5.4px; height:32px; background:var(--green-dim); transform:skewX(12deg)}\n  .tick.mk{height:44px}\n  .tick.on{\n    background:#33cf76;\n    box-shadow:0 0 4px rgba(95,240,155,.6), 0 0 11px rgba(55,205,125,.32), 0 0 24px rgba(40,175,105,.16);\n  }\n  .tick.flash{animation:ignite .32s ease-out}\n  @keyframes ignite{\n    0%{background:#dcffec; box-shadow:0 0 11px rgba(200,255,225,1),0 0 28px rgba(85,230,150,.85),0 0 54px rgba(50,190,120,.45)}\n    100%{background:#33cf76; box-shadow:0 0 4px rgba(95,240,155,.6),0 0 11px rgba(55,205,125,.32),0 0 24px rgba(40,175,105,.16)}\n  }\n\n  .barlabel{left:298px; top:396.4px; font-size:20.4px; font-weight:500; letter-spacing:.9px;\n    line-height:1; color:var(--ink-hi);\n    text-shadow:0 0 3px rgba(200,250,225,.34), 0 0 11px rgba(120,235,175,.3), 0 0 26px rgba(60,195,130,.22)}\n\n  .status{\n    left:0; top:507px; width:1200px; text-align:center;\n    font-size:14px; font-weight:500; line-height:1; letter-spacing:1.42px; text-indent:1.42px;\n    color:#9fd0b6; white-space:pre;\n    text-shadow:0 0 3px rgba(185,240,215,.3), 0 0 10px rgba(110,220,160,.22);\n  }\n  .status .dots{letter-spacing:-1.9px; margin-left:-6px}\n\n  /* ── corner markers ── */\n  .marker{width:0;height:0}\n  .marker i{position:absolute; background:var(--green); opacity:.72}\n  .marker .h{width:9px;height:1.2px} .marker .v{width:1.2px;height:9px}\n  .marker .a-h{left:-17px;top:-17px}  .marker .a-v{left:-17px;top:-17px}\n  .marker .b-h{left:8px;top:-17px}    .marker .b-v{left:15.8px;top:-17px}\n  .marker .c-h{left:-17px;top:15.8px} .marker .c-v{left:-17px;top:8px}\n  .marker .d-h{left:8px;top:15.8px}   .marker .d-v{left:15.8px;top:8px}\n  .marker .dia{\n    left:-4px; top:-4px; width:8px; height:8px; opacity:1;\n    background:var(--green); transform:rotate(45deg);\n    box-shadow:0 0 6px rgba(70,235,145,.7);\n    animation:diaPulse 3.2s ease-in-out infinite;\n  }\n  @keyframes diaPulse{0%,100%{opacity:.55; transform:rotate(45deg) scale(.8)}50%{opacity:1; transform:rotate(45deg) scale(1)}}\n  .m-tl{left:274px; top:340px}   .m-tr{left:926px; top:340px}\n  .m-bl{left:274px; top:508px}   .m-br{left:926px; top:508px}\n  .m-tr .dia{animation-delay:.5s} .m-bl .dia{animation-delay:1.1s} .m-br .dia{animation-delay:1.6s}\n\n  /* ── side rails ── */\n  .rail{left:0; top:0; width:1200px; height:800px}\n  .rail.right{transform:scaleX(-1)}\n  .rail > *{position:absolute}\n\n  .rail .wire{left:104px; top:433px; width:92px; height:1.4px; background:rgba(120,255,185,.24)}\n  .rail .cap{top:428px; height:5px; background:#2bd074; box-shadow:0 0 5px rgba(70,235,145,.6)}\n  .rail .cap.a{left:104px; width:10px}\n  .rail .cap.b{left:181px; width:15px; animation:capPulse 2.4s ease-in-out infinite}\n  @keyframes capPulse{0%,100%{opacity:1}50%{opacity:.5}}\n\n  .mod{left:204px; top:404px; width:36px; height:62px}\n  .mod > *{position:absolute; left:0}\n  .mod .hatch{top:0; width:36px; height:2px; background:#cfe8da}\n  .mod .ret{top:8px; left:3px; width:30px; height:30px; border-radius:50%;\n            border:1.3px solid rgba(206,235,220,.82)}\n  .mod .ret::before,.mod .ret::after{content:\"\"; position:absolute; background:rgba(206,235,220,.45)}\n  .mod .ret::before{left:-3.5px; top:13.6px; width:35px; height:1px}\n  .mod .ret::after{left:13.6px; top:-3.5px; width:1px; height:35px}\n  .mod .dot{top:12.5px; left:15.5px; width:5px; height:5px; border-radius:50%; background:var(--green);\n            box-shadow:0 0 6px rgba(70,235,145,.9); animation:diaPulse 2.6s ease-in-out infinite}\n  .mod .slab{top:46px; width:36px; height:5px; background:#dcefe4;\n             clip-path:polygon(0 0,100% 0,100% 100%,5px 100%)}\n  .mod .led{top:55px; height:2.6px; background:#9dc3b0}\n  .mod .led:nth-of-type(1){left:0;     width:3px}\n  .mod .led:nth-of-type(2){left:4.5px; width:4px}\n  .mod .led:nth-of-type(3){left:27px;  width:4px}\n  .mod .led:nth-of-type(4){left:33px;  width:3px}\n\n  /* ── overlays ── */\n  .scan{position:fixed; inset:0; pointer-events:none; opacity:.18;\n    background:repeating-linear-gradient(to bottom,\n      rgba(160,255,205,.05) 0 calc(1px * var(--s)),\n      transparent calc(1px * var(--s)) calc(3px * var(--s)))}\n\n  .grain{position:fixed; inset:-60px; pointer-events:none;\n    background-repeat:repeat; background-size:80px 80px;\n    animation:grainShift .6s steps(1,end) infinite}\n  .grain.mul{mix-blend-mode:overlay; opacity:.40}\n  .grain.add{opacity:.035; animation-duration:.72s}\n  @keyframes grainShift{\n    0%{transform:translate(0,0)}         20%{transform:translate(-22px,14px)}\n    40%{transform:translate(17px,-19px)} 60%{transform:translate(-13px,-9px)}\n    80%{transform:translate(9px,21px)}   100%{transform:translate(0,0)}\n  }\n\n  .stage.reset{animation:resetGlitch .42s ease-out}\n  @keyframes resetGlitch{\n    0%{filter:brightness(1.8) saturate(.5)} 18%{filter:brightness(.32)}\n    30%{filter:brightness(1.2)} 100%{filter:none}\n  }\n\n  @media (prefers-reduced-motion: reduce){\n    .grain,.readout,.marker .dia,.mod .dot,.rail .cap.b{animation:none !important}\n  }\n</style>\n</head>\n<body>\n  <div class=\"pool\"></div>\n\n  <div class=\"scene\">\n    <div class=\"stage\" id=\"stage\">\n\n      <div class=\"haze\"><i id=\"haze\"></i></div>\n\n      <div class=\"plate\" id=\"plate\"></div>\n      <div class=\"brk tr\"></div><div class=\"brk bl\"></div>\n      <div class=\"readout\"><b id=\"num\">50</b><u>%</u></div>\n\n      <div class=\"barlabel\">UPLINK</div>\n      <div class=\"bar\" id=\"bar\"></div>\n      <div class=\"status\">ESTABLISHING SECURE UPLINK<span class=\"dots\" id=\"dots\">...</span></div>\n\n      <div class=\"marker m-tl\"><i class=\"h a-h\"></i><i class=\"v a-v\"></i><i class=\"h b-h\"></i><i class=\"v b-v\"></i><i class=\"h c-h\"></i><i class=\"v c-v\"></i><i class=\"h d-h\"></i><i class=\"v d-v\"></i><i class=\"dia\"></i></div>\n      <div class=\"marker m-tr\"><i class=\"h a-h\"></i><i class=\"v a-v\"></i><i class=\"h b-h\"></i><i class=\"v b-v\"></i><i class=\"h c-h\"></i><i class=\"v c-v\"></i><i class=\"h d-h\"></i><i class=\"v d-v\"></i><i class=\"dia\"></i></div>\n      <div class=\"marker m-bl\"><i class=\"h a-h\"></i><i class=\"v a-v\"></i><i class=\"h b-h\"></i><i class=\"v b-v\"></i><i class=\"h c-h\"></i><i class=\"v c-v\"></i><i class=\"h d-h\"></i><i class=\"v d-v\"></i><i class=\"dia\"></i></div>\n      <div class=\"marker m-br\"><i class=\"h a-h\"></i><i class=\"v a-v\"></i><i class=\"h b-h\"></i><i class=\"v b-v\"></i><i class=\"h c-h\"></i><i class=\"v c-v\"></i><i class=\"h d-h\"></i><i class=\"v d-v\"></i><i class=\"dia\"></i></div>\n\n      <div class=\"rail left\">\n        <div class=\"wire\"></div><div class=\"cap a\"></div><div class=\"cap b\"></div>\n        <div class=\"mod\">\n          <div class=\"hatch\"></div>\n          <div class=\"ret\"></div>\n          <div class=\"dot\"></div>\n          <div class=\"slab\"></div>\n          <i class=\"led\"></i><i class=\"led\"></i><i class=\"led\"></i><i class=\"led\"></i>\n        </div>\n      </div>\n      <div class=\"rail right\">\n        <div class=\"wire\"></div><div class=\"cap a\"></div><div class=\"cap b\"></div>\n        <div class=\"mod\">\n          <div class=\"hatch\"></div>\n          <div class=\"ret\"></div>\n          <div class=\"dot\"></div>\n          <div class=\"slab\"></div>\n          <i class=\"led\"></i><i class=\"led\"></i><i class=\"led\"></i><i class=\"led\"></i>\n        </div>\n      </div>\n\n    </div>\n  </div>\n\n  <div class=\"scan\"></div>\n  <div class=\"grain mul\" id=\"grain\"></div>\n  <div class=\"grain add\" id=\"grain2\"></div>\n\n<script>\n(() => {\n  const TICKS = 56, MARK_EVERY = 8;\n\n  const root = document.documentElement;\n  const fit = () => root.style.setProperty('--s', Math.min(innerWidth / 1200, innerHeight / 800));\n  addEventListener('resize', fit, {passive:true});\n  fit();\n\n  /* ---- bar ---- */\n  const bar = document.getElementById('bar'), ticks = [];\n  for (let i = 0; i < TICKS; i++){\n    const t = document.createElement('i');\n    t.className = 'tick' + ((i + 1) % MARK_EVERY === 0 ? ' mk' : '');\n    bar.appendChild(t); ticks.push(t);\n  }\n\n  /* ---- grain ---- */\n  (function grain(){\n    const N = 160;\n    const make = fn => {\n      const c = document.createElement('canvas'); c.width = c.height = N;\n      const ctx = c.getContext('2d'), img = ctx.createImageData(N, N), d = img.data;\n      for (let i = 0; i < N * N; i++) fn(d, i * 4);\n      ctx.putImageData(img, 0, 0); return c.toDataURL();\n    };\n    const g = () => (Math.random() + Math.random() + Math.random() + Math.random()) / 4;\n    document.getElementById('grain').style.backgroundImage =\n      `url(${make((d,o) => { const v = 128 + (g() - .5) * 300;\n        d[o] = d[o+1] = d[o+2] = Math.max(0, Math.min(255, v)); d[o+3] = 255; })})`;\n    document.getElementById('grain2').style.backgroundImage =\n      `url(${make((d,o) => { const v = Math.random();\n        d[o] = d[o+1] = d[o+2] = 255;\n        d[o+3] = v < .86 ? 0 : Math.round((v - .86) / .14 * 190); })})`;\n  })();\n\n  /* ---- progress timeline ---- */\n  const KF = [\n    [0,0],[0.045,9],[0.115,9.6],[0.16,22],[0.205,23],[0.30,38],[0.345,39.5],\n    [0.40,53],[0.475,54],[0.545,68],[0.60,69],[0.665,81],[0.735,82],\n    [0.80,92],[0.855,93],[0.925,99],[0.985,99.4],[1.0,100]\n  ];\n  const RUN = 8600, HOLD = 1600, BLANK = 420, LOOP = RUN + HOLD + BLANK;\n  const easeOut = x => 1 - Math.pow(1 - x, 2.1);\n  const valueAt = u => {\n    if (u >= 1) return 100;\n    for (let i = 0; i < KF.length - 1; i++){\n      const [t0,v0] = KF[i], [t1,v1] = KF[i+1];\n      if (u <= t1) return v0 + (v1 - v0) * easeOut((u - t0) / (t1 - t0));\n    }\n    return 100;\n  };\n\n  const PHASES = [\n    [0,  'INITIALIZING CORE SYSTEMS'],\n    [24, 'ESTABLISHING SECURE UPLINK'],\n    [52, 'SYNCHRONIZING NODE ARRAY'],\n    [78, 'DECRYPTING PAYLOAD STREAM'],\n    [100,'UPLINK ESTABLISHED']\n  ];\n  const phaseFor = p => { let t = PHASES[0][1]; for (const [k,v] of PHASES) if (p >= k) t = v; return t; };\n\n  const num   = document.getElementById('num');\n  const dots  = document.getElementById('dots');\n  const haze  = document.getElementById('haze');\n  const stage = document.getElementById('stage');\n  const plate = document.getElementById('plate');\n  const stat  = document.querySelector('.status');\n\n  const FREEZE = new URLSearchParams(location.search).get('p');\n  const barW = 604, tickW = 5.4, gap = (barW - TICKS * tickW) / (TICKS - 1), pitch = tickW + gap;\n\n  let start = performance.now();\n  let lastLit = -1, lastPct = -1, lastDots = -1, lastPhase = '', cycle = 0;\n\n  function frame(now){\n    const e = (now - start) % LOOP;\n    const c = Math.floor((now - start) / LOOP);\n    if (c !== cycle){\n      cycle = c;\n      stage.classList.remove('reset'); void stage.offsetWidth; stage.classList.add('reset');\n    }\n\n    let pct, visible = true;\n    if (e < RUN)             pct = valueAt(e / RUN);\n    else if (e < RUN + HOLD) pct = 100;\n    else { pct = 0; visible = (e - RUN - HOLD) % 220 < 130; }\n    if (FREEZE !== null){ pct = +FREEZE; visible = true; }\n\n    const shown = Math.round(pct);\n    if (shown !== lastPct){\n      num.textContent = String(shown);\n      lastPct = shown;\n      const ph = phaseFor(shown);\n      if (ph !== lastPhase){ lastPhase = ph; stat.firstChild.nodeValue = ph; }\n    }\n    num.parentElement.style.opacity = visible ? '' : '.22';\n\n    const lit = Math.round(pct / 100 * TICKS);\n    if (lit !== lastLit){\n      for (let i = 0; i < TICKS; i++){\n        const on = i < lit;\n        if (ticks[i].classList.contains('on') !== on) ticks[i].classList.toggle('on', on);\n      }\n      if (lit > lastLit && lastLit >= 0 && lit > 0){\n        const h = ticks[lit - 1];\n        h.classList.remove('flash'); void h.offsetWidth; h.classList.add('flash');\n        haze.classList.remove('pulse'); void haze.offsetWidth; haze.classList.add('pulse');\n      }\n      haze.style.setProperty('--lit-w', (lit > 0 ? (lit - 1) * pitch + tickW + gap / 2 : 0) + 'px');\n      if (lit === TICKS){ plate.classList.remove('hit'); void plate.offsetWidth; plate.classList.add('hit'); }\n      lastLit = lit;\n    }\n\n    const d = shown >= 100 ? 0 : (FREEZE !== null ? 3 : Math.floor(((now - start) / 380) % 4));\n    if (d !== lastDots){ dots.textContent = '...'.slice(0, d); lastDots = d; }\n\n    requestAnimationFrame(frame);\n  }\n  requestAnimationFrame(frame);\n})();\n</script>\n</body>\n</html>\n"
    }
